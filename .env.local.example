# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# MongoDB connection string.
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Self-hosted: mongodb://<user>:<pass>@<host>:27017/
MONGODB_URI=

# Database name to use if it isn't part of the connection string above.
MONGODB_DB=hotel_bintang

# Secret used to sign session cookies. At least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# One-time owner account, created by: npm run seed
# Rotate or clear SEED_OWNER_PASSWORD once the account exists.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner

# Optional reception account, also created by: npm run seed
# Useful for testing role separation (reception must get 403 on /owner).
SEED_RECEPTION_EMAIL=
SEED_RECEPTION_PASSWORD=
SEED_RECEPTION_NAME=Reception
